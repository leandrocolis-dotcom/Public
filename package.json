{
  "name": "pendulo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Pêndulo: painel de mercado, carteira e sinais (PWA; build de produção com esbuild em scripts/build.mjs).",
  "scripts": {
    "dev": "node scripts/dev-server.mjs",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "verify:data": "node scripts/verify-data.mjs",
    "test:watch": "vitest",
    "vendor": "node scripts/copy_vendor.mjs",
    "golden": "node scripts/make_golden.mjs",
    "preload": "node scripts/preload_modules.mjs",
    "push:send": "node scripts/send-push.mjs",
    "build:feed": "node scripts/build-quotes-feed.mjs",
    "build:push": "node scripts/build-push.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@fontsource/geist-mono": "^5.3.0",
    "@fontsource/instrument-sans": "^5.3.0",
    "chart.js": "^4.4.7",
    "esbuild": "^0.24.2",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "globals": "^15.14.0",
    "lightweight-charts": "^4.2.3",
    "prettier": "^3.4.2",
    "vitest": "^2.1.8"
  },
  "dependencies": {
    "web-push": "^3.6.7"
  }
}
