      "ordem": "nenhuma"
    }
  ],
  "fuso_exibicao": "America/Sao_Paulo",
  "dia_trading": {
    "reset_contadores_et": "04:00",
    "preco_referencia": "ultimo preco do pos-mercado anterior"
