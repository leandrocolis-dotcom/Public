    "P": "preco ETF",
    "L": "alavancagem"
  },
  "motor": {
    "classificacao_cenario_exibicao": [
      [9, "evento em <=30 min"],
      [8, "ponta no stop ou devolucao>=75"],
      [6, "ponta>=+3R ou subjacente>=1 atr_d desde entrada"],
      [7, "devolucao 50-75"],
      [1, "long>=+1R e short<=-0.5R"],
      [2, "short>=+1R e long<=-0.5R"],
      [4, "ambas<=-0.5R"],
      [3, "ambas>0 e pnl_par>=+1R"],
