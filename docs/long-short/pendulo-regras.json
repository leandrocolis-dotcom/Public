      [0, "MANTER"]
    ],
    "regra": "por posicao vale so a acao de maior prioridade; P0-P2 suspendem ENTRADAS e AUMENTOS no par; bloqueios por finalidade, nunca por lado: COMPRAR_PARA_COBRIR e VENDER para reduzir nunca bloqueados",
    "prioridades": [
      {
        "p": "P0",
        "cond": "RSK-01",
        "acao": "ZERAR tudo"
      },
      {
        "p": "P0",
        "cond": "RSK-03",
        "acao": "REDUZIR posicao de maior contribuicao ao excesso",
        "qtd": "ceil(min necessario), <= q"
